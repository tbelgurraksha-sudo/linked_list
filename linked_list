#include <stdio.h>
#include <stdlib.h>

// Define a Node structure
struct Node {
    int data;
    struct Node* next;
};

// Pointer to track the top of the stack
struct Node* top = NULL;

// Check if the stack is empty
int isEmpty() {
    return top == NULL;
}

// Add an element to the top of the stack
void push(int value) {
    struct Node* newNode = (struct Node*)malloc(sizeof(struct Node));
    
    // Check if memory allocation failed (Heap is full)
    if (newNode == NULL) {
        printf("Heap Overflow! Cannot push %d\n", value);
        return;
    }
    
    newNode->data = value;
    newNode->next = top; // Link the new node to the current top
    top = newNode;       // Update top to point to the new node
    printf("Pushed %d onto the stack.\n", value);
}

// Remove and return the top element
int pop() {
    if (isEmpty()) {
        printf("Stack Underflow! Nothing to pop.\n");
        return -1;
    }
    
    struct Node* temp = top;   // Temporarily store the top node
    int poppedValue = temp->data;
    top = top->next;           // Move top to the next node
    free(temp);                // Deallocate memory of the old node
    
    return poppedValue;
}

// View the top element without removing it
int peek() {
    if (isEmpty()) {
        printf("Stack is empty.\n");
        return -1;
    }
    return top->data;
}

// Display all elements in the stack
void display() {
    if (isEmpty()) {
        printf("Stack is empty.\n");
        return;
    }
    
    struct Node* current = top;
    printf("Current Stack: ");
    while (current != NULL) {
        printf("%d -> ", current->data);
        current = current->next;
    }
    printf("NULL\n");
}

// Driver code to test the linked list stack
int main() {
    push(10);
    push(20);
    push(30);

    display();

    printf("Top element is: %d\n", peek());

    printf("Popped element: %d\n", pop());
    display();

    return 0;
}
